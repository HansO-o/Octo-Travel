{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "target": "ES2022"
  },
  "include": ["functions/**/*.js", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "public"]
}
